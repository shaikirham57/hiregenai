generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  recruiter
  candidate
}

enum JobStatus {
  draft
  open
  paused
  closed
}

enum EmploymentType {
  Full_time @map("Full-time")
  Part_time @map("Part-time")
  Contract
}

enum PipelineStage {
  applied
  screened
  interview
  offer
  hired
  rejected
}

enum RiskLevel {
  low
  medium
  high
}

enum AuthenticityStatus {
  authentic
  suspicious
  high_risk
}

enum AssessmentStatus {
  draft
  published
}

enum IntegrityStatus {
  clean
  tab_switch
  expired_link
}

enum InterviewStatus {
  scheduled
  completed
  canceled
}

enum InterviewRecommendation {
  recommend
  hold
  reject
}

enum NotificationType {
  status_update
  interview
  assessment
  system
}

/// A logged-in HireGen AI account (recruiter or candidate/job-seeker).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  title        String?
  avatarColor  String
  createdAt    DateTime @default(now())

  applications Application[]

  @@map("users")
}

model Job {
  id                String         @id @default(cuid())
  title             String
  department        String
  location          String
  employmentType    EmploymentType
  seniority         String
  status            JobStatus      @default(draft)
  description       String
  responsibilities  String[]       @default([])
  qualifications    String[]       @default([])
  screeningQuestions String[]      @default([])
  skills            String[]       @default([])
  scoringWeights    Json
  salaryRange       Json
  applicantCount    Int            @default(0)
  openDate          DateTime       @default(now())
  hiringManager     String

  candidates    Candidate[]
  applications  Application[]
  assessments   Assessment[]
  interviews    Interview[]

  @@map("jobs")
}

/// Recruiter-side sourced/screened candidate profile (distinct from a portal User account).
model Candidate {
  id                String    @id @default(cuid())
  name              String
  email             String
  location          String
  appliedJobId      String
  job               Job       @relation(fields: [appliedJobId], references: [id])
  avatarColor       String
  skills            String[]  @default([])
  education         String
  employmentHistory Json      @default("[]")
  certifications    String[]  @default([])
  resumeFileName    String
  summaryBullets    String[]  @default([])
  fitScore          Json
  authenticityStatus AuthenticityStatus
  authenticityScore Int
  riskLevel         RiskLevel
  riskFlags         Json      @default("[]")
  languageTag       String
  stage             PipelineStage @default(applied)
  appliedAt         DateTime  @default(now())

  assessmentResults AssessmentResult[]
  interviews        Interview[]

  @@map("candidates")
}

/// Candidate-portal application: what a logged-in candidate User submitted for a Job.
model Application {
  id                String        @id @default(cuid())
  candidateId       String
  candidate         User          @relation(fields: [candidateId], references: [id])
  candidateProfileId String?
  jobId             String
  job               Job           @relation(fields: [jobId], references: [id])
  jobTitle          String
  company           String
  location          String
  stage             PipelineStage @default(applied)
  appliedAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  timeline          Json          @default("[]")
  personalInfo      Json?
  background        Json?
  screeningAnswers  Json?
  resumeFileName    String?
  matchScore        Float?
  interviewDetails  Json?

  @@map("applications")
}

model Assessment {
  id               String            @id @default(cuid())
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id])
  jobTitle         String
  title            String
  status           AssessmentStatus  @default(draft)
  questions        Json
  weightInFitScore Int
  dueDate          DateTime?

  results AssessmentResult[]

  @@map("assessments")
}

model AssessmentResult {
  id              String          @id @default(cuid())
  assessmentId    String
  assessment      Assessment      @relation(fields: [assessmentId], references: [id])
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id])
  candidateName   String
  mcqScore        Int
  behavioralScore Int
  integrityStatus IntegrityStatus @default(clean)
  completedAt     DateTime        @default(now())

  @@map("assessment_results")
}

model Interview {
  id                String                   @id @default(cuid())
  candidateId       String
  candidate         Candidate                @relation(fields: [candidateId], references: [id])
  candidateName     String
  jobId             String
  job               Job                      @relation(fields: [jobId], references: [id])
  jobTitle          String
  scheduledAt       DateTime
  interviewer       String
  status            InterviewStatus          @default(scheduled)
  questions         Json
  transcriptExcerpt String?
  competencyScores  Json?
  overallScore      Int?
  strengths         Json?
  weaknesses        Json?
  recommendation    InterviewRecommendation?
  justification     String?

  @@map("interviews")
}

/// Notifications are shared per role in this app (matches the existing frontend contract of
/// `getNotifications(role)`, not a per-user inbox) — preserved as-is from the prior mock behavior.
model Notification {
  id          String           @id @default(cuid())
  role        UserRole
  type        NotificationType
  title       String
  body        String
  createdAt   DateTime         @default(now())
  read        Boolean          @default(false)
  aiGenerated Boolean          @default(false)

  @@map("notifications")
}
